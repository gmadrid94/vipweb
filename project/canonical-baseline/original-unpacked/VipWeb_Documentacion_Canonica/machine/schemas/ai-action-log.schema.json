{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "actor_type",
      "actor_id",
      "ai_level",
      "action_type",
      "permission_used",
      "target_type",
      "target_id",
      "scope",
      "files_read",
      "files_changed",
      "approval_id",
      "evidence_ref",
      "risk_level",
      "status",
      "result",
      "error_summary",
      "created_at"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "actor_type": {
        "enum": [
          "human",
          "ai",
          "system"
        ]
      },
      "actor_id": {
        "type": "string",
        "minLength": 1
      },
      "ai_level": {
        "enum": [
          "AI-0",
          "AI-1",
          "AI-2",
          "AI-3",
          "AI-4",
          "HUMAN_ONLY"
        ]
      },
      "action_type": {
        "type": "string",
        "minLength": 1
      },
      "permission_used": {
        "type": "string",
        "minLength": 1
      },
      "target_type": {
        "type": "string",
        "minLength": 1
      },
      "target_id": {
        "type": "string",
        "minLength": 1
      },
      "scope": {
        "type": [
          "string",
          "object"
        ],
        "additionalProperties": true
      },
      "files_read": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "files_changed": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "approval_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "evidence_ref": {
        "type": [
          "string",
          "null"
        ]
      },
      "risk_level": {
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ]
      },
      "status": {
        "enum": [
          "planned",
          "drafted",
          "approved",
          "applied",
          "failed",
          "rejected",
          "cancelled"
        ]
      },
      "result": {
        "type": [
          "string",
          "null"
        ]
      },
      "error_summary": {
        "type": [
          "string",
          "null"
        ]
      },
      "created_at": {
        "type": "string",
        "minLength": 1
      },
      "metadata": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "files_changed": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        "then": {
          "properties": {
            "approval_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "approval_id"
          ]
        }
      }
    ]
  }
}
