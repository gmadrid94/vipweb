{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "type",
    "documentation_baseline",
    "generated_at",
    "status",
    "checks",
    "evidence_path",
    "dated_report_path",
    "integrity_manifest_ref"
  ],
  "additionalProperties": true,
  "properties": {
    "evidence_path": {
      "type": "string",
      "const": "evidence/sprint-0-local-execution.md"
    },
    "dated_report_path": {
      "type": "string",
      "pattern": "^evidence/[0-9]{4}-[0-9]{2}-[0-9]{2}/doctor-validation-canonica\\.json$"
    },
    "integrity_manifest_ref": {
      "type": "string",
      "const": "evidence/sprint-0-local-execution.md"
    },
    "documentation_baseline": {
      "type": "string",
      "const": "1.0"
    }
  }
}
