{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "priority",
      "phase",
      "title",
      "module",
      "dependencies",
      "acceptance_criteria",
      "evidence",
      "status",
      "description",
      "actions",
      "files_affected",
      "doctor_check",
      "expected_evidence",
      "risk",
      "local_rollback",
      "blocking",
      "wamp_relevant",
      "ai_read_required",
      "source_doc"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^(C1|UX2|G3|I3|A3|AI3)-[0-9]{3}[A-Z]?$"
      },
      "priority": {
        "enum": [
          "P0",
          "P1",
          "P2",
          "P3"
        ]
      },
      "phase": {
        "enum": [
          "2",
          "3",
          "4",
          "5",
          "6"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "module": {
        "type": "string",
        "minLength": 1
      },
      "dependencies": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "acceptance_criteria": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "evidence": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "enum": [
          "pending",
          "in_progress",
          "blocked",
          "done",
          "cancelled"
        ]
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "actions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "files_affected": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "doctor_check": {
        "type": "string",
        "minLength": 1
      },
      "expected_evidence": {
        "type": "string",
        "minLength": 1
      },
      "risk": {
        "type": "string",
        "minLength": 1
      },
      "local_rollback": {
        "type": "string",
        "minLength": 1
      },
      "blocking": {
        "type": "boolean"
      },
      "wamp_relevant": {
        "type": "boolean"
      },
      "ai_read_required": {
        "type": "boolean"
      },
      "source_doc": {
        "type": "string",
        "minLength": 1
      },
      "parent_task_id": {
        "type": "string",
        "minLength": 1
      },
      "supersedes": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "superseded_by": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "must_close_with": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "is_umbrella": {
        "type": "boolean"
      },
      "implementation_role": {
        "enum": [
          "standalone",
          "base",
          "hardening",
          "replacement",
          "umbrella",
          "validation"
        ]
      },
      "relationship_note": {
        "type": "string",
        "minLength": 1
      },
      "scope_intent": {
        "type": "string",
        "minLength": 1
      },
      "allowed_paths": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "forbidden_paths": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "requires_subtask_split": {
        "type": "boolean"
      },
      "approval_scope_hash_required": {
        "type": "boolean"
      },
      "rollback_unit": {
        "type": "string",
        "minLength": 1
      },
      "scope_note": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
