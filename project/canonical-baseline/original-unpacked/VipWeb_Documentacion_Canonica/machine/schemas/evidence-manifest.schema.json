{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "checksum_contract",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "checksum_contract": {
      "const": "sha256_lowercase_bytes"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_path",
          "role",
          "checksum_algorithm",
          "checksum",
          "source_run_id"
        ],
        "additionalProperties": false,
        "properties": {
          "artifact_path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "checksum_algorithm": {
            "const": "sha256"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_run_id": {
            "type": "string",
            "minLength": 1
          },
          "mirrors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
