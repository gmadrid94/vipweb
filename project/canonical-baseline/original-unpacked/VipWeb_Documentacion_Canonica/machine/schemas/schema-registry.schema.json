{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_registry",
    "action_payload_schema_registry",
    "event_payload_schema_registry",
    "generation_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_registry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "action_payload_schema_registry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "event_payload_schema_registry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "generation_policy": {
      "type": "object",
      "required": [
        "source_of_truth",
        "purpose",
        "does_not_replace_contracts",
        "last_reviewed"
      ],
      "additionalProperties": false,
      "properties": {
        "source_of_truth": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "does_not_replace_contracts": {
          "type": "boolean"
        },
        "last_reviewed": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "file",
        "schema_type",
        "parent_contract",
        "owner",
        "status",
        "used_by",
        "validates",
        "human_document",
        "last_reviewed",
        "doctor_check_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "schema_type": {
          "enum": [
            "machine_catalog_schema",
            "action_payload_schema",
            "event_payload_schema"
          ]
        },
        "parent_contract": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "canonical",
            "support"
          ]
        },
        "used_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validates": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_document": {
          "type": "string",
          "minLength": 1
        },
        "last_reviewed": {
          "type": "string",
          "minLength": 1
        },
        "doctor_check_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
