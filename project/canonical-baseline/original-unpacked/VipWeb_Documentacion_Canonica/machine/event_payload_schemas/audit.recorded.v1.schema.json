{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machine/event_payload_schemas/audit.recorded.v1.schema.json",
  "title": "audit.recorded v1 payload",
  "type": "object",
  "required": [
    "audit_id",
    "actor_id",
    "action",
    "risk_level",
    "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "audit_id": {
      "type": "string"
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "action": {
      "type": "string"
    },
    "risk_level": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
