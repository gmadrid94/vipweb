{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machine/action_payloads/MODULE_CONFIGURE.response.schema.json",
  "title": "MODULE_CONFIGURE success response",
  "type": "object",
  "required": [
    "ok",
    "data",
    "error",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "required": [
        "module_id",
        "manifest_version",
        "config_keys_changed"
      ],
      "additionalProperties": false,
      "properties": {
        "module_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "manifest_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "config_keys_changed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "error": {
      "type": "null"
    },
    "meta": {
      "type": "object",
      "required": [
        "request_id",
        "action_id",
        "emitted_events"
      ],
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string"
        },
        "action_id": {
          "const": "MODULE_CONFIGURE"
        },
        "emitted_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
