{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machine/action_payloads/ONBOARDING_COMPLETE.response.schema.json",
  "title": "ONBOARDING_COMPLETE success response",
  "type": "object",
  "required": [
    "ok",
    "data",
    "error",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "required": [
        "session_id",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "const": "completed"
        },
        "progress_processing": {
          "enum": [
            "event_emitted",
            "gamification_disabled",
            "consumer_pending"
          ],
          "description": "Estado informativo; ONBOARDING_COMPLETE no escribe ProgressRecord directamente."
        }
      }
    },
    "error": {
      "type": "null"
    },
    "meta": {
      "type": "object",
      "required": [
        "request_id",
        "action_id",
        "emitted_events"
      ],
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string"
        },
        "action_id": {
          "const": "ONBOARDING_COMPLETE"
        },
        "emitted_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
