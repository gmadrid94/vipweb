{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machine/action_payloads/ONBOARDING_START.response.schema.json",
  "title": "ONBOARDING_START success response",
  "type": "object",
  "required": [
    "ok",
    "data",
    "error",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "required": [
        "session_id",
        "status",
        "current_step"
      ],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "enum": [
            "started",
            "resumed"
          ]
        },
        "current_step": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "error": {
      "type": "null"
    },
    "meta": {
      "type": "object",
      "required": [
        "request_id",
        "action_id",
        "emitted_events"
      ],
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string"
        },
        "action_id": {
          "const": "ONBOARDING_START"
        },
        "emitted_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
