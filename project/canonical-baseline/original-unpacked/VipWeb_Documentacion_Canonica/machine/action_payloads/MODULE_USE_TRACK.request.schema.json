{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machine/action_payloads/MODULE_USE_TRACK.request.schema.json",
  "title": "MODULE_USE_TRACK request body",
  "type": "object",
  "required": [
    "request_id",
    "csrf_token",
    "payload",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "csrf_token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "payload": {
      "type": "object",
      "required": [
        "user_id",
        "module_id",
        "used_at",
        "source_route"
      ],
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "module_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "used_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    }
  }
}
