{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "entity",
      "field_or_rule",
      "constraint_type",
      "criticality",
      "enforcement_db",
      "enforcement_application",
      "enforcement_doctor",
      "evidence_required",
      "decision_ref",
      "source_doc"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^DCE-[0-9]{3}$"
      },
      "entity": {
        "type": "string",
        "minLength": 1
      },
      "table": {
        "type": [
          "string",
          "null"
        ]
      },
      "field_or_rule": {
        "type": "string",
        "minLength": 1
      },
      "constraint_type": {
        "type": "string",
        "minLength": 1
      },
      "criticality": {
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ]
      },
      "enforcement_db": {
        "$ref": "#/$defs/enforcement"
      },
      "enforcement_application": {
        "$ref": "#/$defs/enforcement"
      },
      "enforcement_doctor": {
        "type": "object",
        "required": [
          "required",
          "check_id"
        ],
        "additionalProperties": false,
        "properties": {
          "required": {
            "type": "boolean"
          },
          "check_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "evidence_required": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "decision_ref": {
        "type": "string",
        "minLength": 1
      },
      "source_doc": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "enforcement": {
      "type": "object",
      "required": [
        "required",
        "mechanism"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
