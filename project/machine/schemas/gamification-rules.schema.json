{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "principle",
    "rules",
    "achievements",
    "anti_fatigue",
    "processing_contract"
  ],
  "additionalProperties": false,
  "properties": {
    "principle": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "trigger_event",
          "effect",
          "points",
          "cooldown",
          "achievement_id",
          "requires_user_context",
          "forbidden_if_event_has_critical_doctor_status",
          "eligibility"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GAM-RULE-[0-9]{3}$"
          },
          "trigger_event": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "minLength": 1
          },
          "points": {
            "type": "integer",
            "minimum": 0
          },
          "cooldown": {
            "type": "object",
            "required": [
              "type",
              "scope"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "none",
                  "once",
                  "once_per_day",
                  "per_task",
                  "per_scope"
                ]
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "achievement_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "requires_user_context": {
            "type": "boolean"
          },
          "forbidden_if_event_has_critical_doctor_status": {
            "type": "boolean"
          },
          "eligibility": {
            "type": "object",
            "required": [
              "required_payload_fields",
              "user_context_source",
              "required_actor_type",
              "forbidden_actor_types",
              "requires_non_null_user_id",
              "forbidden_status_values"
            ],
            "additionalProperties": false,
            "properties": {
              "required_payload_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "user_context_source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "required_actor_type": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "human",
                  "ai",
                  "system",
                  null
                ]
              },
              "forbidden_actor_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "human",
                    "ai",
                    "system"
                  ]
                },
                "uniqueItems": true
              },
              "requires_non_null_user_id": {
                "type": "boolean"
              },
              "forbidden_status_values": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "achievements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "condition",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "object",
            "required": [
              "operator",
              "events"
            ],
            "additionalProperties": false,
            "properties": {
              "operator": {
                "enum": [
                  "ALL",
                  "ANY"
                ]
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "anti_fatigue": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "processing_contract": {
      "type": "object",
      "required": [
        "handler_module",
        "consumes_events",
        "writes_entities",
        "emits_events",
        "idempotency_rule",
        "fallback_if_disabled",
        "direct_write_from_producer_allowed",
        "reads_entities",
        "catalog_entities",
        "evaluates_achievement_conditions"
      ],
      "additionalProperties": false,
      "properties": {
        "handler_module": {
          "const": "gamification"
        },
        "consumes_events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "writes_entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "emits_events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "idempotency_rule": {
          "type": "string",
          "minLength": 1
        },
        "fallback_if_disabled": {
          "type": "string",
          "minLength": 1
        },
        "direct_write_from_producer_allowed": {
          "const": false
        },
        "reads_entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "catalog_entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evaluates_achievement_conditions": {
          "const": true
        }
      }
    }
  }
}
