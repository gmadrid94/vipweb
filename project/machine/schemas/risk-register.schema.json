{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "category",
      "description",
      "probability",
      "impact",
      "early_signals",
      "mitigation",
      "decision",
      "phase",
      "id",
      "primary_phase_id",
      "phase_ids",
      "risk_layer"
    ],
    "additionalProperties": true,
    "properties": {
      "id": {
        "type": "string"
      },
      "primary_phase_id": {
        "type": "string"
      },
      "phase_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "risk_layer": {
        "const": "strategic"
      },
      "phase_label": {
        "type": "string"
      }
    }
  }
}
