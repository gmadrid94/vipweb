{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machine/action_payloads/INTEGRATION_CONFIGURE_STUB.request.schema.json",
  "title": "INTEGRATION_CONFIGURE_STUB request body",
  "type": "object",
  "required": [
    "request_id",
    "csrf_token",
    "payload",
    "approval_id",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "csrf_token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "payload": {
      "type": "object",
      "required": [
        "provider",
        "mode",
        "config_patch",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "mode": {
          "const": "stub"
        },
        "config_patch": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null",
              "object",
              "array"
            ]
          }
        },
        "reason": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        }
      }
    },
    "approval_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    }
  }
}
