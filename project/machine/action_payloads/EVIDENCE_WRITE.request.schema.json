{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "machine/action_payloads/EVIDENCE_WRITE.request.schema.json",
  "title": "EVIDENCE_WRITE request body",
  "type": "object",
  "required": [
    "request_id",
    "csrf_token",
    "payload",
    "approval_id",
    "idempotency_key"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "csrf_token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "payload": {
      "type": "object",
      "required": [
        "source_run_id",
        "status",
        "scope",
        "checksum",
        "checksum_algorithm",
        "evidence_path",
        "integrity_manifest_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "source_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "warning"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "checksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "checksum_algorithm": {
          "const": "sha256"
        },
        "integrity_manifest_ref": {
          "type": "string",
          "const": "evidence/sprint-0-local-execution.md"
        }
      }
    },
    "approval_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    }
  }
}
