  "draft_entity": "AIDraft",
  "ai_write_draft_rule": "AI_WRITE_DRAFT crea AIDraft y AIActionLog; no modifica target_doc, código ni archivos protegidos del producto; applied_by_human solo puede registrarlo un owner humano tras aplicación manual.",
  "protected_file_application_requires_version_control": true,
