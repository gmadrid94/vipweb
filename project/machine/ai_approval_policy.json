    "ai.write_draft": "AI-2",
    "evidence.write": "AI-2",
    "doctor.status.validate": "HUMAN_ONLY"
  },
  "separation_rule": "Ejecutar Doctor readonly no escribe evidencia; evidence.write escribe evidencia versionada; doctor.status.validate valida estado y solo lo ejecuta owner humano con ApprovalRecord.",
